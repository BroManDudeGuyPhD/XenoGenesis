    <script>
        // Pass session data to client
        window.sessionData = <%- sessionData %>;
        
        // IMMEDIATE DEBUGGING - before DOM is ready
        console.log('🚀 IMMEDIATE: Session data set in EJS template:', window.sessionData);
        if (window.sessionData) {
            console.log('🚀 IMMEDIATE: isLoggedIn =', window.sessionData.isLoggedIn);
            console.log('🚀 IMMEDIATE: username =', window.sessionData.username);
            
            // Check if user arrived via invite link
            if (window.sessionData.inviteCode) {
                console.log('🔗 IMMEDIATE: Invite code from link:', window.sessionData.inviteCode);
            }
        }
        
        // Pre-fill invite code if user arrived via invite link
        function prefillInviteCode() {
            if (window.sessionData && window.sessionData.inviteCode && !window.sessionData.isLoggedIn) {
