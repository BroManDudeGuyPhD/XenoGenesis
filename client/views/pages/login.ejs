    <link rel="stylesheet" href="/client/css/style.css?v=2025102401">
    
    <!-- Preload styles to prevent FOUC and login button flash -->
    <style>
        /* Prevent background flash on page load */
        body {
            background-color: #272A3B !important;
            transition: background-color 0.3s ease;
        }
        
        /* Smooth transitions for UI elements */
        #loginNav, .profile-menu-container {
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }
        
        /* Prevent layout shift during load */
        .header {
            opacity: 1 !important;
            visibility: visible !important;
        }
        
        /* Add loading overlay to prevent FOUC */
        #pageLoadOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #272A3B;
            z-index: 9999;
            transition: opacity 0.3s ease;
        }
        
        #pageLoadOverlay.fade-out {
            opacity: 0;
            pointer-events: none;
        }
    </style>
    
    <% 
    // Parse session data to determine initial UI state
    let isLoggedIn = false;
    if (typeof sessionData !== 'undefined') {
        try {
            const parsedSessionData = JSON.parse(sessionData);
            isLoggedIn = parsedSessionData && parsedSessionData.isLoggedIn && parsedSessionData.username;
        } catch (e) {
            isLoggedIn = false;
        }
    }
    %>
    
    <% if (isLoggedIn) { %>
    <!-- CSS for logged-in users - hide login button immediately -->
    <style>
        #loginNav,
        .nav-item #loginNav,
        .nav-menu #loginNav,
        header #loginNav,
        nav #loginNav {
            display: none !important;
            visibility: hidden !important;
            opacity: 0 !important;
            width: 0 !important;
            height: 0 !important;
            overflow: hidden !important;
            position: absolute !important;
            left: -9999px !important;
        }
        
        .profile-menu-container {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        /* Hide any login-related elements */
        .nav-menu .nav-item:has(#loginNav) {
            display: none !important;
        }
        
        /* Ensure login button stays hidden even if something tries to show it */
        body #loginNav,
        html #loginNav {
            display: none !important;
        }
    </style>
    <% } else { %>
    <!-- CSS for logged-out users - hide profile menu immediately -->
    <style>
        .profile-menu-container {
            display: none !important;
            visibility: hidden !important;
            opacity: 0 !important;
        }
        
        #loginNav {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
    </style>
    <% } %>
    
    <title>MetaMatching</title>
    <link rel="icon" type="image/x-icon" href="../client/img/favicon.png">
</head>

